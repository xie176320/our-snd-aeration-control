{
  "name": "Wastewater SND / OUR",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "mkdir -p data/processed outputs && python -m pip install --upgrade pip && python -m pip install -e '.[plot,web,dev]'",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "OUR-SND Dashboard",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "PYTHONUTF8": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode"
}
