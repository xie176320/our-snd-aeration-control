page {
  --brand: #087f72;
  --brand-dark: #075e56;
  --brand-soft: #dff2ee;
  --ink: #14201d;
  --muted: #687772;
  --line: #dfe8e5;
  --surface: #ffffff;
  --canvas: #f4f8f7;
  --warning: #bc6b12;
  --warning-soft: #fff1dd;
  --danger: #b73b48;
  --danger-soft: #fde8eb;
  --safe: #087f72;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 20rpx;
  font-weight: 600;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
}

.card {
  background: var(--surface);
  border: 1rpx solid rgba(15, 79, 70, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(22, 67, 60, 0.06);
}

.section-heading {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin: 38rpx 4rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-note {
  color: var(--muted);
  font-size: 23rpx;
}

.primary-button {
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  line-height: 88rpx;
}

.secondary-button {
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 28rpx;
  line-height: 84rpx;
}

.ghost-button {
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 76rpx;
}

.muted {
  color: var(--muted);
}

.mono {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}

.disclaimer {
  color: #74817d;
  font-size: 22rpx;
  line-height: 1.65;
  margin: 30rpx 10rpx 0;
  text-align: center;
}
