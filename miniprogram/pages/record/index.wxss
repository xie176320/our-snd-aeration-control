.intro {
  background: linear-gradient(140deg, #eef8f5 0%, #ffffff 76%);
  padding: 30rpx;
}

.intro__eyebrow {
  color: #087f72;
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.intro__title {
  display: block;
  font-size: 34rpx;
  font-weight: 750;
  margin-top: 12rpx;
}

.intro__text {
  color: #687772;
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.error-box {
  background: #fde8eb;
  border: 1rpx solid rgba(183, 59, 72, 0.18);
  border-radius: 22rpx;
  color: #9e2936;
  margin-top: 22rpx;
  padding: 24rpx;
}

.error-box__title {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.error-box__item {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
}

.form-section {
  margin-top: 22rpx;
  padding: 28rpx 26rpx 30rpx;
}

.form-section__header {
  align-items: center;
  border-bottom: 1rpx solid #edf1f0;
  display: flex;
  gap: 18rpx;
  margin-bottom: 26rpx;
  padding-bottom: 22rpx;
}

.form-section__number {
  color: #b8c5c1;
  font-size: 34rpx;
  font-weight: 800;
}

.form-section__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.form-section__desc {
  color: #86918e;
  display: block;
  font-size: 20rpx;
  margin-top: 5rpx;
}

.picker-row,
.field-grid,
.button-row {
  display: grid;
  gap: 18rpx;
  grid-template-columns: 1fr 1fr;
}

.field {
  display: block;
  margin-bottom: 20rpx;
  min-width: 0;
}

.field--full {
  grid-column: 1 / -1;
}

.field__label {
  color: #4f5d59;
  display: block;
  font-size: 22rpx;
  margin: 0 0 10rpx 4rpx;
}

.field__input-wrap,
.field__picker {
  align-items: center;
  background: #f5f8f7;
  border: 1rpx solid #e2e9e7;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  min-height: 84rpx;
  padding: 0 18rpx;
}

.field__input {
  flex: 1;
  font-size: 27rpx;
  min-width: 0;
}

.field__unit {
  color: #87938f;
  flex: 0 0 auto;
  font-size: 16rpx;
  margin-left: 8rpx;
  max-width: 88rpx;
  text-align: right;
}

.field__picker {
  color: #26332f;
  font-size: 26rpx;
}

.note-field {
  margin-bottom: 0;
  margin-top: 4rpx;
}

.field__textarea {
  background: #f5f8f7;
  border: 1rpx solid #e2e9e7;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  height: 150rpx;
  line-height: 1.5;
  padding: 18rpx;
  width: 100%;
}

.button-stack {
  margin-top: 28rpx;
}

.button-row {
  margin-top: 16rpx;
}

.button-row button {
  width: 100%;
}
