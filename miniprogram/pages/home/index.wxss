.home {
  padding-top: 24rpx;
}

.hero {
  background: linear-gradient(145deg, #075e56 0%, #087f72 58%, #0e9b89 100%);
  box-shadow: 0 18rpx 44rpx rgba(8, 127, 114, 0.23);
  color: #fff;
  overflow: hidden;
  padding: 34rpx;
  position: relative;
}

.hero::after {
  border: 2rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  content: '';
  height: 280rpx;
  position: absolute;
  right: -120rpx;
  top: -100rpx;
  width: 280rpx;
}

.hero__topline {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.hero__eyebrow {
  color: rgba(255, 255, 255, 0.68);
  display: block;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero__title {
  display: block;
  font-size: 48rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.hero__subtitle {
  color: rgba(255, 255, 255, 0.78);
  display: block;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.hero__focus {
  align-items: flex-end;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 22rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  position: relative;
  z-index: 1;
}

.hero__focus-label,
.hero__grade-label {
  color: rgba(255, 255, 255, 0.66);
  display: block;
  font-size: 21rpx;
}

.hero__focus-number {
  align-items: baseline;
  display: flex;
  font-size: 58rpx;
  font-weight: 750;
  gap: 10rpx;
  margin-top: 6rpx;
}

.hero__focus-unit {
  font-size: 22rpx;
  font-weight: 500;
}

.hero__grade {
  text-align: right;
}

.hero__grade-value {
  display: block;
  font-size: 50rpx;
  font-weight: 750;
  margin-top: 8rpx;
}

.hero__button {
  background: #fff;
  color: #075e56;
  font-size: 26rpx;
  line-height: 78rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.metrics {
  display: grid;
  gap: 18rpx;
  grid-template-columns: 1fr 1fr;
}

.alert {
  align-items: flex-start;
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 26rpx;
}

.alert__icon {
  align-items: center;
  background: #dff2ee;
  border-radius: 16rpx;
  color: #087f72;
  display: flex;
  flex: 0 0 52rpx;
  font-size: 30rpx;
  font-weight: 800;
  height: 52rpx;
  justify-content: center;
}

.alert--warning .alert__icon {
  background: #fff1dd;
  color: #bc6b12;
}

.alert--danger .alert__icon {
  background: #fde8eb;
  color: #b73b48;
}

.alert__body {
  flex: 1;
}

.alert__title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
}

.alert__text {
  color: #687772;
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.chart-card {
  padding: 24rpx 20rpx 20rpx;
}

.quick-actions {
  display: grid;
  gap: 18rpx;
  grid-template-columns: 1fr 1fr;
}

.quick-action {
  padding: 26rpx 24rpx;
}

.quick-action__mark {
  align-items: center;
  background: #dff2ee;
  border-radius: 16rpx;
  color: #087f72;
  display: flex;
  font-size: 34rpx;
  height: 58rpx;
  justify-content: center;
  width: 58rpx;
}

.quick-action__title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.quick-action__desc {
  color: #77847f;
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.about-link {
  color: #087f72;
  font-size: 24rpx;
  margin-top: 36rpx;
  text-align: center;
}
