.summary {
  align-items: flex-end;
  background: linear-gradient(135deg, #075e56 0%, #0a8f80 100%);
  color: #fff;
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
}

.summary__eyebrow {
  color: rgba(255, 255, 255, 0.65);
  display: block;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.summary__number {
  font-size: 62rpx;
  font-weight: 780;
}

.summary__unit {
  color: rgba(255, 255, 255, 0.75);
  font-size: 21rpx;
  margin-left: 10rpx;
}

.summary__actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  text-align: right;
}

.summary__actions text {
  background: rgba(255, 255, 255, 0.13);
  border-radius: 999rpx;
  font-size: 21rpx;
  padding: 10rpx 18rpx;
}

.filters {
  background: #e9efed;
  border-radius: 18rpx;
  display: flex;
  gap: 8rpx;
  margin: 24rpx 0;
  padding: 7rpx;
}

.filter {
  border-radius: 14rpx;
  color: #687772;
  flex: 1;
  font-size: 23rpx;
  padding: 15rpx 0;
  text-align: center;
}

.filter--active {
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(27, 66, 60, 0.08);
  color: #087f72;
  font-weight: 700;
}

.record {
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.record__header {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
}

.record__time {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
}

.record__source {
  color: #87938f;
  display: block;
  font-size: 19rpx;
  margin-top: 6rpx;
}

.record__metrics {
  background: #f5f8f7;
  border-radius: 18rpx;
  display: grid;
  gap: 1rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 22rpx;
}

.record__metrics > view {
  padding: 18rpx;
}

.record__metrics text:first-child {
  color: #77847f;
  display: block;
  font-size: 19rpx;
}

.record__metrics text:last-child {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  margin-top: 5rpx;
}

.record__unit {
  color: #87938f;
  font-size: 17rpx;
  font-weight: 400;
}

.record__note {
  color: #687772;
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  margin-top: 18rpx;
}

.record__footer {
  border-top: 1rpx solid #edf1f0;
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
}

.record__footer button {
  flex: 1;
  font-size: 22rpx;
  line-height: 68rpx;
}

.record__use {
  background: #dff2ee;
  color: #087f72;
}

.record__delete {
  background: #f5f7f6;
  color: #7c8885;
}

.empty {
  padding: 56rpx 34rpx;
  text-align: center;
}

.empty__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.empty__text {
  color: #687772;
  display: block;
  font-size: 23rpx;
  margin: 12rpx 0 28rpx;
}
