.chart {
  width: 100%;
}

.chart__plot {
  align-items: flex-end;
  border-bottom: 1rpx solid #dfe8e5;
  display: flex;
  gap: 10rpx;
  height: 320rpx;
  justify-content: space-around;
  padding: 34rpx 4rpx 0;
}

.chart__column {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  height: 100%;
  justify-content: flex-end;
  max-width: 68rpx;
  min-width: 34rpx;
}

.chart__value {
  color: #687772;
  font-size: 18rpx;
  margin-bottom: 8rpx;
}

.chart__bar {
  background: linear-gradient(180deg, #3bb5a5 0%, #087f72 100%);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  min-height: 12rpx;
  width: 100%;
}

.chart__bar--over {
  background: linear-gradient(180deg, #e7a24f 0%, #bc6b12 100%);
}

.chart__label {
  color: #77847f;
  font-size: 18rpx;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 86rpx;
}

.chart__legend {
  align-items: center;
  color: #77847f;
  display: flex;
  font-size: 20rpx;
  gap: 10rpx;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.chart__legend-dot {
  background: #bc6b12;
  border-radius: 50%;
  height: 12rpx;
  width: 12rpx;
}

.chart__empty {
  color: #86918e;
  font-size: 24rpx;
  padding: 80rpx 0;
  text-align: center;
}
